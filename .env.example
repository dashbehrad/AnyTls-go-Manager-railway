# ==============================================================================
# AnyTLS Manager Panel - Environment Variables
# Optimized for Railway, Docker Containers, and Linux VPS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Admin Authentication Variables (Railway Variables)
# ------------------------------------------------------------------------------
# Set custom administrator credentials directly via environment variables.
# Ideal for Railway deployments to maintain credentials across redeploys.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# ------------------------------------------------------------------------------
# 2. Railway TCP Proxy Configuration
# ------------------------------------------------------------------------------
# In Railway: Go to Service Settings -> Networking -> TCP Proxying -> Add TCP Proxy
# (Proxy internal container port 8443 to external proxy domain & port)
# Railway will assign a public domain and port (e.g., junction.proxy.rlwy.net:12345).
# These variables auto-fill generated AnyTLS configs for NekoBox, Sing-Box & Clash.
RAILWAY_TCP_PROXY_DOMAIN=junction.proxy.rlwy.net
RAILWAY_TCP_PROXY_PORT=12345

# Fallback generic TCP proxy variables
TCP_PROXY_HOST=
TCP_PROXY_PORT=

# Default internal port for AnyTLS server inside Railway container (default: 8443)
ANYTLS_PORT=8443

# Default SNI domain for camouflage (e.g., cloudflare.com, speedtest.net)
SNI_DEFAULT=cloudflare.com

# ------------------------------------------------------------------------------
# 3. Server Port Configuration
# ------------------------------------------------------------------------------
# Web panel HTTP port (in Railway, PORT is automatically injected by the platform)
PORT=3000

# Standalone mode flag (true for VPS / standalone Linux)
STANDALONE_PANEL=false
VITE_STANDALONE=false
