# ==============================================================================
# AnyTLS Manager Panel - Environment Variables
# Optimized for Railway, Docker Containers, and Linux VPS
# ==============================================================================

# ==============================================================================
# 🌟 ONLY 2 VARIABLES REQUIRED IN RAILWAY VARIABLES:
# Everything else (ports, TCP proxy, SNI, core binary) is 100% AUTOMATIC!
# ==============================================================================
USERNAME=admin
PASSWORD=your_secure_password_here

# Aliases also supported:
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your_secure_password_here

# ==============================================================================
# 🤖 AUTOMATIC VARIABLES (DO NOT NEED TO SET MANUALLY IN RAILWAY)
# ==============================================================================
# 1. Railway TCP Proxy:
#    When you click "Add TCP Proxy" on internal port 8443 in Railway Settings,
#    Railway automatically injects these two variables into the container:
#    RAILWAY_TCP_PROXY_DOMAIN=junction.proxy.rlwy.net
#    RAILWAY_TCP_PROXY_PORT=12345
#
# 2. Web Panel HTTP Port:
#    Injected automatically by Railway:
#    PORT=3000
#
# 3. AnyTLS Internal Listen Port:
#    Defaults automatically to 8443 inside the container.
#    (Only override if you specifically need a different internal port)
#    ANYTLS_PORT=8443
#
# 4. Default SNI Camouflage:
#    Defaults automatically to cloudflare.com
#    SNI_DEFAULT=cloudflare.com
